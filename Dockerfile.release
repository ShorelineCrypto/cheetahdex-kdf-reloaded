# Runtime image for the release `kdf` binary (built separately on the CI builder
# into `target-xenial/release/kdf`).
#
# Base is a *supported* Ubuntu LTS: the previous `ubuntu:bionic` (18.04) and the
# xenial builder are both EOL, so they cannot receive fixes for issues such as
# gnupg CVE-2025-68973 or systemd CVE-2021-33910 without an Ubuntu Pro/ESM
# subscription — an in-place `apt dist-upgrade` on an EOL release fetches nothing.
# 24.04 (noble) is under standard security support, so `apt upgrade` delivers the
# patched base packages. The binary is built against xenial's old glibc, which
# runs forward-compatibly on newer glibc.
FROM ubuntu:24.04

# Pull the latest security patches and keep only what a runtime needs
# (ca-certificates for TLS root verification). gnupg is an apt keyring tool with
# no role at runtime, so drop it to remove that attack surface entirely.
RUN apt-get update \
 && apt-get -y upgrade \
 && apt-get -y install --no-install-recommends ca-certificates \
 && apt-get -y purge gnupg gpgv 2>/dev/null || true \
 && apt-get -y autoremove --purge \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /mm2
COPY target-xenial/release/kdf /app/kdf
EXPOSE 7783
ENV PATH="/app:${PATH}"
CMD kdf